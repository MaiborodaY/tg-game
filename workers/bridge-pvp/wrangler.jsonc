{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "account_id": "49cdef49a797b94dda3328ef3c4b2d6e",
  "name": "bridge-pvp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-25",
  "vars": {
    "ENVIRONMENT": "production"
  },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BRIDGE_ROOM",
        "class_name": "BridgeRoom"
      },
      {
        "name": "BRIDGE_USER_SESSION",
        "class_name": "BridgeUserSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BridgeRoom", "BridgeUserSession"]
    }
  ]
}
