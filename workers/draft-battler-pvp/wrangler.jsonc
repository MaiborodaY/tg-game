{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "account_id": "49cdef49a797b94dda3328ef3c4b2d6e",
  "name": "draft-battler-pvp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-05",
  "vars": {
    "PVP_ENABLED": "true",
    "ENVIRONMENT": "production",
    "PVP_ALLOWED_ORIGINS": "https://draft-battler-pvp.mr-maybik.workers.dev"
  },
  "secrets": {
    "required": ["BOT_TOKEN"]
  },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "WOL_DB",
      "database_name": "wol",
      "database_id": "3c0de039-c071-4928-9a77-f46632240f4a"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DRAFT_PVP_ROOM",
        "class_name": "DraftPvpRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DraftPvpRoom"]
    }
  ]
}
